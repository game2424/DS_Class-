#include <iostream>
using namespace std;

int main()
{
    int bookIds[100], count = 0, choice, searchId;

    cout << "\n===== Library Book System =====\n"
         << "1. Add book ID\n"
         << "2. Display all book IDs\n"
         << "3. Search for a book ID\n"
         << "4. Exit\n"
         << "Enter your choice: ";
    cin >> choice;

    if (choice == 1)
    {
        cout << "Enter book ID: ";
        cin >> bookIds[count++];
        cout << "Book ID added.\n";
    }
    else if (choice == 2)
    {
        cout << "All book IDs:\n";
        for (int index = 0; index < count; index++)
            cout << bookIds[index] << "\n";
    }
    else if (choice == 3)
    {
        cout << "Enter book ID to search: ";
        cin >> searchId;
        for (int index = 0; index < count; index++)
            if (bookIds[index] == searchId)
                cout << "Book found with ID: " << searchId << "\n";
    }
    else if (choice == 4)
        cout << "Exiting the program.\n";

    return 0;
}
