#include <iostream>
using namespace std;

void menu()
{
    int choice;

    cout << "\n1. Pizza";
    cout << "\n2. Burger";
    cout << "\n3. Pasta";
    cout << "\n4. Exit";

    cout << "\nEnter choice: ";
    cin >> choice;

    if(choice == 4)
        return;

    if(choice == 1)
        cout << "Pizza selected\n";
    else if(choice == 2)
        cout << "Burger selected\n";
    else if(choice == 3)
        cout << "Pasta selected\n";
    else
        cout << "Invalid choice\n";

    menu();
}

int main()
{
    menu();
    return 0;
}
